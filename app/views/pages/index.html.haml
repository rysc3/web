-# ── Masthead ──────────────────────────────────────────────────
- content_for :masthead do
  -# A taller stage than the plate. The plate sticks to the top through
  -# the extra height, which buys a stretch of scroll where nothing moves
  -# except the nav rising into place.
  .masthead-stage.movement
    %header.masthead
      -# The one photograph on the site that carries grain. The mask on
      -# .masthead__media dissolves image and grit together into the stock.
      .masthead__media.press
        = responsive_image_tag "Profile-05.jpg", alt: "Ryan Scherbarth", class: "masthead__img", sizes: "100vw", loading: "eager", fetchpriority: "high"
        .masthead__hold{"aria-hidden" => "true"}
        .press__grit{"aria-hidden" => "true"}
        .press__grit.press__grit--lift{"aria-hidden" => "true"}

      .masthead__inner
        %h1.masthead__title Ryan Scherbarth

      .masthead__nav-anchor{"aria-hidden" => "true"}

-# ── 01 · Standing ─────────────────────────────────────────────
#profile.shell.section.section--screen.movement

  .intro
    .intro__portrait.reveal
      -# A carousel, not a sheet — four frames of the same subject. It still
      -# hands the viewer its frames: data-frames on the carousel, data-frame
      -# and the file to open on each slide.
      .gallery.gallery--portrait{data: {autoplay: 15000, frames: true, plate: "Portraits"}, "data-frame-key" => "portrait", role: "region", "aria-roledescription" => "carousel", "aria-label" => "Portraits"}
        .gallery__bar
          - portrait_frames.each_with_index do |_, i|
            %button.gallery__seg{type: "button", "aria-label" => "Photo #{i + 1}"}
              %span.gallery__seg-fill
        .gallery__viewport{tabindex: "0"}
          - portrait_frames.each do |file, alt|
            .gallery__slide{data: {frame: true, full: viewer_src(file)}, "data-frame-id" => File.basename(file, ".*")}
              = responsive_image_tag file, alt: alt, sizes: "(min-width: 820px) 42vw, 100vw"

    .intro__body.reveal
      %p.lede
        Sr. Software Engineer, ML &amp; HPC Infra at NVIDIA.

      .intro__actions
        %a.btn.btn--ember{href: "/resume"}
          View my resume
          = icon("arrow-right")
        %a.btn{href: "/meet"}
          Schedule a meeting
          = icon("clock")

      %dl.intro__facts
        .intro__fact
          %dt Now
          %dd Sr. Software Engineer @ NVIDIA
        .intro__fact
          %dt Focus
          %dd ML &amp; HPC Infrastructure
        .intro__fact
          %dt Education
          %dd B.S. Computer Science, UNM
        .intro__fact
          %dt Other
          %dd
            %ul.intro__list
              %li
                %a.link{href: "/sc26"} SC26 Student Cluster Competition
              %li
                %a.link{href: "https://hoti.org/2026/committees.html", target: "_blank", rel: "noopener"} Hot Interconnects 2026

      .social
        - social_items.each do |s|
          %a.social__link{href: s[:url], target: (s[:url].start_with?("mailto") ? nil : "_blank"), rel: "noopener", "aria-label" => s[:label]}
            = icon(s[:icon])

-# ── 02 · Trajectory ───────────────────────────────────────────
- tl = career_timeline

#timeline.section.movement
  .shell
    .tl-bench.reveal
      .pills
        %button.pill{type: "button", data: {filter: "all"}, "aria-pressed" => "true"} Both
        %button.pill.pill--pro{type: "button", data: {filter: "professional"}, "aria-pressed" => "false"}
          %span.pill__dot{"aria-hidden" => "true"}
          Professional
        %button.pill.pill--extra{type: "button", data: {filter: "extracurricular"}, "aria-pressed" => "false"}
          %span.pill__dot{"aria-hidden" => "true"}
          Extracurricular

  .tl{style: "--tl-span: #{tl[:span]}; --tl-lanes: #{tl[:lanes]};", data: {timeline: true, span: tl[:span], y0: tl[:y0], m0: tl[:m0]}}
    .tl__chart
      .tl__plot
        %span.tl__spine
        - tl[:months].each do |m|
          %span.tl-tick{class: (m[:major] ? "tl-tick--major" : nil), style: "--t: #{m[:t]};"}
        - tl[:years].each do |y|
          %span.tl-year{style: "--t: #{y[:t]};"}
            %span.tl-year__label= y[:year]
        %span.tl-now{style: "--t: #{tl[:now_t]};"}
          %span.tl-now__label Now
        - tl[:rows].each_with_index do |r, i|
          %button.tl-bar{type: "button", class: ["tl-bar--#{r[:entry][:track]}", (r[:open] ? "tl-bar--open" : nil)], style: "--t: #{r[:top]}; --d: #{r[:d]}; --lane: #{r[:lane]};", data: {t: r[:t], d: r[:d], jump: i}, "aria-label" => "#{r[:entry][:org]}, #{r[:dates]}"}
            - r[:promos].each do |k|
              %span.tl-bar__promo{style: "--k: #{k};"}
        %span.tl__play

    %ol.tl__entries
      - tl[:rows].each_with_index do |r, i|
        - e = r[:entry]
        %li.tl-entry.reveal{class: "tl-entry--#{e[:track]}", id: "tl-#{i}", data: {track: e[:track], t: r[:t], jump: i}}
          %p.tl-entry__meta
            %span.tl-entry__dates{class: (r[:open] ? "is-live" : nil)}= r[:dates]
            %span.tl-entry__dur{"aria-hidden" => "true"}= r[:dur_short]
            %span.visually-hidden= r[:dur_long]
            %span.tl-entry__span{"aria-hidden" => "true", style: "--t: #{r[:top]}; --d: #{r[:d]};"}
              %span.tl-entry__span-fill
          .tl-entry__row
            - if e[:logo]
              -# logo_light marks are drawn for a dark ground, so they get
              -# an ink chip rather than vanishing into the stock.
              %span.tl-entry__mark{class: (e[:logo_light] ? "tl-entry__mark--ink" : nil)}
                %img{src: asset_path(e[:logo]), alt: e[:alt], loading: "lazy", decoding: "async"}
            - else
              %span.tl-entry__mark.tl-entry__mark--type{"aria-hidden" => "true"}= e[:mark] || org_monogram(e[:org])
            .tl-entry__body
              - if r[:roles].size > 1
                -# One tenure, several titles. The org leads; the roles
                -# stack under it with the promotion marked between them.
                %p.tl-entry__org.tl-entry__org--lead= e[:org]
                %ol.tl-roles
                  - r[:roles].each_with_index do |role, ri|
                    %li.tl-role{class: (ri.zero? ? "tl-role--latest" : nil)}
                      %h3.tl-role__title= role[:title]
                      %span.tl-role__dates= role[:dates]
                      - if role[:desc]
                        %p.tl-entry__desc= raw(role[:desc])
              - else
                %h3.tl-entry__title= e[:title]
                %p.tl-entry__org= e[:org]
                - if e[:desc]
                  %p.tl-entry__desc= raw(e[:desc])

-# ── 03 · Elsewhere ────────────────────────────────────────────
#site-map.bleed.section

  - panels = home_panels

  .bento.bento--six.reveal
    - panels.each_with_index do |p, i|
      %a.panel{href: p[:href], class: (p[:mark] ? "panel--mark" : nil)}
        = responsive_image_tag p[:img], alt: "", class: "panel__img", sizes: "(min-width: 760px) 34vw, 50vw"
        .panel__scrim{"aria-hidden" => "true"}
        .panel__body
          %div
            %span.panel__index= format("%02d", i + 1)
            %span.panel__title= p[:title]
            %span.panel__sub= p[:sub]
          %span.panel__arrow{"aria-hidden" => "true"}
            = icon("arrow-right")

-# ── 05 · Plates ───────────────────────────────────────────────
- plates = photo_plates

#images.bleed.section

  .plates
    - plates.each do |plate|
      .reveal
        .plate__head
          - if plate[:href]
            - external = plate[:href].start_with?("http")
            %a.plate__title{href: plate[:href], target: (external ? "_blank" : nil), rel: (external ? "noopener" : nil)}= plate[:title]
          - else
            %span.plate__title= plate[:title]
          %span.plate__meta= plate[:meta]

        -# One group across every plate: the headings stay, but prev/next
        -# walks the whole section rather than stopping at each plate.
        = render "mosaic", plate: plate, group: "images"

-# ── Archive ─────────────────────────────────────────────────
- archive = archive_entries

#archive.bleed.section

  .reveal
    %button.disclosure__trigger{type: "button", data: {disclosure: true}, "aria-expanded" => "false", "aria-controls" => "archive-list"}
      = "Open the archive · #{archive.size} entries"
      = icon("chevron-down")

    #archive-list.disclosure__panel
      %div
        .index-list
          - archive.each do |date, title, href|
            - external = href.start_with?("http")
            %a.index-row{href: href, target: (external ? "_blank" : nil), rel: (external ? "noopener" : nil)}
              %span.index-row__date= date
              %span.index-row__title= title
              %span.index-row__mark{"aria-hidden" => "true"}
                = icon(external ? "arrow-out" : "arrow-right")

= render "viewer"
