.shell
  .page-hero.reveal
    .page-hero__mark.sc-mark
      %img{src: asset_path('sc23_logo_2.png'), alt: 'SC23', fetchpriority: "high", decoding: "async"}
    .page-hero__body
      %h1.page-hero__title Team UNM · SC23
      %p.page-hero__sub HPC Student Cluster Competition
      %p.page-hero__meta Denver, CO · November 2023
      .page-hero__links
        - sc23_links.each do |label, href|
          %a.page-hero__link{href: href, target: "_blank", rel: "noopener"}
            = icon("arrow-out")
            = label

-# ── 01 · Team poster ──────────────────────────────────────────
.shell.section

  .sc-plate.sc-plate--wide.reveal
    %button.disclosure__trigger.sc-toggle{type: "button", data: {disclosure: true}, "aria-expanded" => "false", "aria-controls" => "sc23-poster"}
      View Team Poster
      = icon("chevron-down")
    #sc23-poster.disclosure__panel
      %div
        .sc-poster
          .sc-poster__sheet
            %img{src: asset_path('SC23Poster.jpg'), alt: 'SC23 Poster', loading: "lazy", decoding: "async"}
          %a.btn{href: sc23_poster_pdf, target: "_blank", rel: "noopener"}
            = icon("pdf")
            View PDF

-# ── 02 · Photos ───────────────────────────────────────────────
-# A contact sheet, cut by the same packer the home page uses.
- set = sc23_set

.bleed.section

  -# No plate heading: SC23 has one set, so a label above it would only
  -# repeat the page. The title and meta still ride the sheet for the
  -# viewer's head.
  .reveal
    = render "mosaic", plate: set, key: "sc23"

= render "viewer"
