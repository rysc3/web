-# ── Resume ────────────────────────────────────────────────────
-# A normal PDF viewer, with its edges clipped away.
-#
-# The browser's reader cannot be styled from outside — it paints a grey
-# field around the page and a margin the page is fitted inside. So the
-# frame is deliberately oversized by exactly that margin and the wrapper
-# clips it: what is left is the page, edge to edge, with the reader's
-# chrome outside the crop. Selecting and copying still work, because this
-# is still the real PDF.
- pdf = "/Ryan%20Scherbarth%20-%20Resume.pdf#toolbar=0&navpanes=0&scrollbar=0&statusbar=0&view=FitH"
- content_for :bleed do
  .resume
    %a.btn.btn--ember.resume__get{href: "/Ryan%20Scherbarth%20-%20Resume.pdf", download: "Ryan Scherbarth - Resume.pdf"}
      Download PDF
      = icon("download")

    .resume__sheet
      %iframe.resume__doc{src: pdf, title: "Ryan Scherbarth — resume"}
