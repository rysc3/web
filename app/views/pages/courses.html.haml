.shell.shell--wide
  .page-hero.reveal
    .page-hero__body
      %h1.page-hero__title Courses
      %p.page-hero__sub B.S. Computer Science, Minor in Mathematics · University of New Mexico
      %p.page-hero__meta.courses-ink December 2024

  %dl.courses-summary.reveal
    .courses-summary__cell.courses-summary__cell--total
      %dt.courses-summary__label Total (incl. transfer)
      %dd.courses-summary__value= course_total_credits
    .courses-summary__cell
      %dt.courses-summary__label Semesters
      %dd.courses-summary__value= course_semesters.size
    .courses-summary__cell
      %dt.courses-summary__label Courses
      %dd.courses-summary__value= course_count
    .courses-summary__cell
      %dt.courses-summary__label Span
      %dd.courses-summary__value= course_year_span

.shell.shell--wide.section

  .courses-sheet
    - course_semesters.each_with_index do |semester, i|
      %section.courses-term.reveal{data: {"reveal-i" => [i, 3].min}}
        %h2.courses-term__head
          %span.courses-term__name= semester[:name]
          %span.courses-term__rule{"aria-hidden" => "true"}
          %span.courses-term__credits= "#{semester[:credits]} cr"
        .courses-term__rows
          - semester[:courses].each do |course|
            .courses-row
              %span.courses-row__code= course[:code]
              %span.courses-row__title= course[:title]
              %span.courses-row__credits
                = course[:credits]
                %span.visually-hidden>= course[:credits] == 1 ? "credit" : "credits"
