-# ── 404 ────────────────────────────────────────────────────────
-# The old parallax script drove #starfield, which the redesign
-# removed. Big serif, one quiet sans line, paper.
.shell.nf
  .nf__inner
    .nf__frame
      %img.nf__photo{src: asset_path('Profile-05.jpg'), alt: 'Ryan Scherbarth', decoding: "async"}
