!!!
%html{lang: "en", class: "no-js"}
  %head
    %meta{charset: "utf-8"}
    %meta{name: "viewport", content: "width=device-width, initial-scale=1, viewport-fit=cover"}
    %meta{name: "theme-color", content: "#f0eee6"}
    %meta{name: "color-scheme", content: "light"}

    -# Flip the no-JS flag before first paint so styles never flash the
    -# fallback state on a JS-capable browser.
    :javascript
      document.documentElement.classList.remove('no-js');

    %title= @page_title || "Ryan Scherbarth"
    = csrf_meta_tags
    = csp_meta_tag

    %meta{name: "description", content: @og_description || "Ryan Scherbarth — Senior Software Engineer, AI/ML at NVIDIA."}
    %meta{name: "author", content: "Ryan Scherbarth"}
    %meta{name: "keywords", content: "ryan, ryan scherbarth, scherbarth, ry, UNM, University of New Mexico, New Mexico, Sandia Labs, Sandia, SNL, National Lab, National Labs, Center for Advanced Research Computing, student, computer science, cs, intern, internship, software engineer, SWE, Solutions Architect, engineer, bachelors, masters, cyber security, HPC, high performance computing, super computers, super computer, supercomputer, supercomputing, ML, machine learning, tesla, FSD, full self driving, tesla full self driving, tesla auto pilot, tesla autopilot, autopilot, nvidia, NVIDIA, GPU, AI, artificial intelligence, AI/ML, deep learning, CUDA, accelerated computing"}
    %link{rel: "canonical", href: request.original_url}

    %meta{property: "og:title", content: @page_title || "Ryan Scherbarth"}
    %meta{property: "og:description", content: @og_description || "Ryan Scherbarth — Senior Software Engineer at NVIDIA."}
    %meta{property: "og:image", content: asset_url(@og_image || 'Profile-05.jpg')}
    %meta{property: "og:type", content: "website"}
    %meta{property: "og:url", content: request.original_url}
    %meta{name: "twitter:card", content: "summary_large_image"}

    -# The same pip that sits beside the brand in the nav. site.js takes this
    -# over and breathes it; this is the resting frame, and the only frame if
    -# scripting is off.
    %link{rel: "icon", type: "image/png", href: asset_path("favicon-dot.png")}

    -# Self-hosted variable fonts. Preloading only the two latin faces
    -# that render above the fold; latin-ext and italic stay lazy.
    %link{rel: "preload", as: "font", type: "font/woff2", crossorigin: "anonymous", href: asset_path("Newsreader-latin.woff2")}
    %link{rel: "preload", as: "font", type: "font/woff2", crossorigin: "anonymous", href: asset_path("Inter-latin.woff2")}

    = stylesheet_link_tag 'application', media: 'all'
    = javascript_include_tag 'site', defer: true

    %script{type: "application/ld+json"}
      - schema = {"@context" => "https://schema.org", "@type" => "Person", "name" => "Ryan Scherbarth", "url" => "https://ryanscherbarth.com", "image" => asset_url("Profile-05.jpg"), "jobTitle" => "Senior Software Engineer, AI/ML", "worksFor" => {"@type" => "Organization", "name" => "Nvidia"}, "alumniOf" => {"@type" => "CollegeOrUniversity", "name" => "University of New Mexico"}, "sameAs" => ["https://www.linkedin.com/in/ryanscherbarth/", "https://github.com/rysc3"]}
      = raw(schema.to_json)
    - if @og_image.present?
      %script{type: "application/ld+json"}
        - image_schema = {"@context" => "https://schema.org", "@type" => ["ImageObject", "Thing"], "name" => @page_title || "Ryan Scherbarth", "url" => request.url, "image" => asset_url(@og_image), "author" => {"@type" => "Person", "name" => "Ryan Scherbarth"}, "creator" => {"@type" => "Person", "name" => "Ryan Scherbarth"}, "description" => @og_description || "Image from ryanscherbarth.com"}
        = raw(image_schema.to_json)

    -# Google Analytics, deferred so it never competes with first paint.
    %script{async: true, src: "https://www.googletagmanager.com/gtag/js?id=G-7VD1T7W41S"}
    :javascript
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-7VD1T7W41S');

  %body
    = render "shared/icons"

    %a.skip-link{href: "#main"} Skip to content

    .progress{"aria-hidden" => "true"}

    %nav.nav{"aria-label" => "Primary"}
      .nav__bar
        %a.nav__brand{href: "/"}
          %span.nav__pip{"aria-hidden" => "true"}
          Ryan Scherbarth
        %button.nav__toggle{type: "button", "aria-label" => "Menu", "aria-expanded" => "false", "aria-controls" => "menu"}
          %span
          %span
      .nav__links
        - nav_items.each do |item|
          %a.nav__link{href: item[:path], "aria-current" => (nav_current?(item[:path]) ? "page" : nil)}= item[:label]

    #menu.menu{"aria-label" => "Menu"}
      - nav_items.each do |item|
        %a.menu__link{href: item[:path]}= item[:label]
      .menu__foot
        - social_items.each do |s|
          %a.social__link{href: s[:url], target: (s[:url].start_with?("mailto") ? nil : "_blank"), rel: "noopener", "aria-label" => s[:label]}
            = icon(s[:icon])

    .blurable
      = yield :masthead

      %main#main.content{role: "main"}
        -# Three shapes: a page with a masthead, a full-bleed page that
        -# manages its own spacing, and the standard padded page.
        - if content_for?(:masthead)
          = yield
        - elsif content_for?(:bleed)
          = yield :bleed
        - else
          .page
            = yield

      %footer.footer
        .bleed
          .footer__base
            -# Reads from the local checkout when there is one, else the
            -# public repo's latest commit. Silent if neither answers.
            - if last_updated_at
              %p.footer__stamp
                Updated #{last_updated_date}
                %button.footer__elapsed{type: "button", data: {elapsed: last_updated_elapsed_ms}, title: "Click to change units"}
                  &nbsp;
            - else
              %span
            .social
              - social_items.each do |s|
                %a.social__link{href: s[:url], target: (s[:url].start_with?("mailto") ? nil : "_blank"), rel: "noopener", "aria-label" => s[:label]}
                  = icon(s[:icon])

